# Copy to .env and fill in. .env is gitignored — never commit real secrets.

# Optional free Gemini key from AI Studio; used only for the Gemini fallback.
GEMINI_API_KEY=
# Primary agent provider: ollama (default) or gemini. Gemini is the optional fallback.
AEGIS_MODEL_PROVIDER=ollama
# No endpoint is bundled. Enter your own local Ollama URL.
AEGIS_OLLAMA_URL=
AEGIS_OLLAMA_MODEL=qwen2.5:14b
AEGIS_OLLAMA_EXECUTABLE=runtime\ollama\ollama.exe
OLLAMA_MODELS=runtime\ollama-models
AEGIS_OLLAMA_CONTEXT=4096
AEGIS_OLLAMA_TIMEOUT=180
AEGIS_BROWSER_ENABLED=1
AEGIS_GEMINI_MODEL=gemini-3.1-flash-lite
# Gemini fallback chain, tried in order when the fallback model is busy (HTTP 503) or rate-limited.
AEGIS_GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-2.5-flash-lite,gemini-3.5-flash

# Targets are NOT bundled with this release. Enter your own localhost URLs.
# The guardrail still accepts only http(s)://localhost and http(s)://127.0.0.1.
AEGIS_DEFAULT_TARGET=
AEGIS_GATE_1_URL=
AEGIS_GATE_2_URL=
AEGIS_GATE_3_URL=
# Optional local source paths used by /quick for each gate (inside this project).
AEGIS_GATE_1_SOURCE=
AEGIS_GATE_2_SOURCE=
AEGIS_GATE_3_SOURCE=

# Optional local hardware.
AEGIS_SERIAL_PORT=

# Local API used by the Telegram bot. No default is bundled.
AEGIS_API_BASE=

# Telegram bonus. Token from @BotFather. Empty allowed-chat list = public bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
# Optional comma list for the read-only owner console. Empty = every chat that
# already passed the allow-list may view it (still read-only, no secrets).
TELEGRAM_OWNER_CHAT_IDS=
# auto = try verified Premium custom emoji, fall back to Unicode if Telegram
# rejects them. unicode = never attempt custom emoji.
TELEGRAM_EMOJI_MODE=auto
